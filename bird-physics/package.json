{
  "name": "bird-physics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit --reporter=verbose",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:coverage": "vitest run tests/unit tests/integration --coverage",
    "test:watch": "vitest",
    "test:e2e": "DEBUG=pw:browser playwright test",
    "test:e2e:host": "MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_RDD_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 DEBUG=pw:browser playwright test --retries=1",
    "test:e2e:update": "DEBUG=pw:browser playwright test --update-snapshots",
    "test:e2e:capture": "DEBUG=pw:browser playwright test tests/e2e/capture.spec.ts",
    "check": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e:host"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "planck": "^1.4.2"
  }
}
