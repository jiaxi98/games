  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "planck": "^1.4.2"
  }
}
